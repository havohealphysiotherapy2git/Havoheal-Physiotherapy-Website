##############################################################################
# Havoheal Physiotherapy UK LTD — environment variables
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Values are validated at runtime by src/lib/env.ts, which fails with a clear
# message listing every problem at once.
##############################################################################

# --- Database (required) -----------------------------------------------------
# PostgreSQL connection string. Include ?sslmode=require for managed providers.
DATABASE_URL="postgresql://user:password@localhost:5432/havoheal?schema=public"

# --- Site (required in production) -------------------------------------------
# Canonical origin, no trailing slash. Used for canonicals, sitemap, OG tags
# and the admin link in notification emails.
NEXT_PUBLIC_SITE_URL="https://havohealphysiotherapy.co.uk"

# --- Email -------------------------------------------------------------------
# "console" logs a redacted summary instead of sending. Use it in development
# and CI so no real email is ever sent by accident.
# "resend" sends live email and requires the three settings below.
EMAIL_PROVIDER="resend"

# Resend API key. Create at https://resend.com.
# IMPORTANT: owning the Titan mailbox does NOT authorise Resend to send from
# havohealphysiotherapy.co.uk. The domain must be verified with Resend by adding
# its SPF and DKIM records. See docs/email-setup.md before going live.
RESEND_API_KEY=""

# The From address. Must be on a domain verified with the sending provider.
BOOKING_FROM_EMAIL="Havoheal Physiotherapy <bookings@havohealphysiotherapy.co.uk>"

# Where customer replies should land.
BOOKING_REPLY_TO_EMAIL="bookings@havohealphysiotherapy.co.uk"

# Where new booking requests and enquiries are sent internally.
BOOKING_NOTIFICATION_EMAIL="bookings@havohealphysiotherapy.co.uk"

# --- Booking confirmation ----------------------------------------------------
# 32+ random characters. Signs the short-lived cookie that lets the confirmation
# page show a booking without putting the reference in the URL.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BOOKING_CONFIRMATION_SECRET=""

# --- Admin access ------------------------------------------------------------
# The admin area stays DISABLED until all three are set. There is no default
# account and no bypass.
ADMIN_EMAIL=""
# Generate with:  npm run admin:hash -- "your-long-random-password"
# Store only the hash. Never put a plaintext password in this file.
ADMIN_PASSWORD_HASH=""
# 32+ random characters, different from BOOKING_CONFIRMATION_SECRET.
ADMIN_SESSION_SECRET=""

# --- Bot protection (optional) -----------------------------------------------
# Cloudflare Turnstile. When both are set, booking submissions are verified.
# Leave blank to rely on the honeypot and rate limiting alone.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Analytics (optional, consent-gated) -------------------------------------
# "none" (default) means no analytics, no cookie banner and no third-party
# script. Nothing loads until the visitor consents.
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=""

# --- Address lookup (optional) -----------------------------------------------
# "none" (default) uses manual address fields, which always work.
# Set to "getaddress" or "ideal-postcodes" and supply a key to enable lookup.
# Check the provider's UK GDPR terms before enabling.
ADDRESS_LOOKUP_PROVIDER="none"
ADDRESS_LOOKUP_API_KEY=""
