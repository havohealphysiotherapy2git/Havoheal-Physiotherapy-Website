// Havoheal Physiotherapy UK LTD — booking database schema.
//
// Design notes:
//  - `date` + `startTime` are stored as business-local strings so day and slot
//    lookups are exact and timezone-proof.
//  - `startsAt` stores the same moment as a UTC instant for sorting and range
//    queries.
//  - Customer-provided text (`importantMessage`) is kept separate from internal
//    `staffNotes` so staff commentary never mixes with what the customer wrote.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

/// Delivery state of a transactional email.
enum EmailStatus {
  PENDING
  SENT
  FAILED
  /// Suppressed on purpose, e.g. the console provider in development.
  SKIPPED
}

model Booking {
  id        String @id @default(cuid())
  /// Human-friendly reference shown to the customer, e.g. "HH-7K2P4M".
  reference String @unique

  // --- Appointment slot -------------------------------------------------
  /// Business-local date, "YYYY-MM-DD".
  date      String
  /// Business-local start time, "HH:mm".
  startTime String
  /// Business-local end time, "HH:mm", derived from the slot duration.
  endTime   String
  /// The same instant in UTC, for sorting and reporting.
  startsAt  DateTime
  /// Duration in minutes at the time of booking (config may change later).
  durationMinutes Int
  /// Price in pence at the time of booking (config may change later).
  priceInPence    Int

  // --- Customer ---------------------------------------------------------
  fullName String
  email    String
  phone    String
  postcode String
  /// Street address for the home visit.
  address  String
  /// Optional flat, apartment or unit number.
  addressFlat     String?
  /// Optional building or house name.
  addressBuilding String?
  /// How to get in: buzzer codes, key safes, side entrances, dogs, stairs.
  accessInstructions String?
  /// Where the physiotherapist can park.
  parkingInformation String?
  /// Free-text supplied by the customer. May contain personal information —
  /// never log or email this field in a subject line.
  importantMessage String?

  // --- Terms acceptance --------------------------------------------------
  //
  // IMPORTANT — read before interpreting these columns.
  //
  // None of these is UK GDPR "consent" under Article 6(1)(a). Booking data is
  // processed under Article 6(1)(b) — steps taken at the customer's request
  // before entering a contract, and performance of that contract — as stated in
  // the Privacy Policy. Consent is used on this site only for analytics
  // cookies, which are recorded elsewhere entirely.
  //
  // None of them is marketing consent either. We send no marketing, and these
  // columns must never be used to justify any.
  //
  // The column NAMES are historical. They date from a version of the booking
  // form that asked the customer to tick six boxes on the review step. Those
  // boxes were removed; renaming the columns would need a production migration
  // for no functional gain, so the names stay and this comment carries the
  // meaning.
  //
  // How to read a row:
  //   * `termsAcceptedAt` is set on every booking — it is the moment the
  //     customer submitted, having been shown the acceptance notice.
  //   * The BookingEvent audit trail records HOW acceptance was given. An
  //     event of type "terms-accepted" means click-wrap (current behaviour).
  //     Bookings taken before that event existed were explicit tick-boxes.

  /// Privacy Policy was presented and accepted. Acceptance is by submitting the
  /// form under a notice that links to the policy — not a ticked box.
  consentPrivacy   Boolean
  /// Booking and Cancellation Policy was presented and accepted, same way.
  consentPolicy    Boolean
  /// The customer agreed we may contact them ABOUT THIS BOOKING by phone,
  /// WhatsApp or email. Operational contact only. NOT marketing consent, and
  /// not the lawful basis for the contact — that is Article 6(1)(b).
  consentContact   Boolean

  /// Set only while the review step asked for it. `false` on newer bookings
  /// means "not asked", never "the customer declined".
  confirmedServiceArea Boolean @default(false)
  /// As above — "not asked" when false.
  confirmedAddressAccurate Boolean @default(false)
  /// As above — "not asked" when false.
  confirmedRequestNotBooking Boolean @default(false)

  /// When the terms above were accepted, i.e. the moment of submission.
  /// Column named `consentedAt` for historical reasons; it is an acceptance
  /// timestamp, not evidence of GDPR consent.
  consentedAt      DateTime

  // --- Workflow ---------------------------------------------------------
  status      BookingStatus @default(PENDING)
  /// Internal staff commentary. Never shown to the customer.
  staffNotes  String?
  confirmedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  /// Set when an appointment is moved; points at the previous slot.
  rescheduledFrom String?

  // --- Integrity and audit ----------------------------------------------
  /// Client-generated key that makes repeated submissions safe.
  idempotencyKey String? @unique
  /// Truncated/hashed request metadata for abuse investigation only.
  requestFingerprint String?

  // --- Email delivery tracking ------------------------------------------
  // A booking is never rolled back because email failed. These fields record
  // what happened so a failure can be spotted, retried and reported.
  customerEmailStatus EmailStatus @default(PENDING)
  businessEmailStatus EmailStatus @default(PENDING)
  customerEmailSentAt DateTime?
  businessEmailSentAt DateTime?
  /// Short, non-sensitive error code only. Never a raw provider payload,
  /// which could contain personal data or credentials.
  emailLastErrorCode  String?
  emailRetryCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events BookingEvent[]

  /// Several patients may hold the same date + start time: the business sends
  /// out multiple physiotherapists, so a slot is not an exclusive resource.
  /// There is deliberately NO unique constraint on (date, startTime) — any
  /// per-slot limit is a business setting (`bookingConfig.maxBookingsPerSlot`)
  /// enforced in the insert transaction, not a data-integrity invariant.
  /// This index exists purely to make capacity counts and day views fast.
  @@index([date, startTime])
  @@index([startsAt])
  @@index([status])
  @@index([email])
  @@index([customerEmailStatus])
  @@index([businessEmailStatus])
}

/// Append-only audit trail. Contains no customer medical information.
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// e.g. "created", "confirmed", "cancelled", "rescheduled", "completed".
  type      String
  /// Who acted: "customer", "system", or an admin email.
  actor     String
  /// Short, non-sensitive description of the change.
  detail    String?
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

/// Dates the business is closed, editable without a code deploy.
/// `src/config/booking.ts` blockedDates are merged with these at runtime.
model BlockedDate {
  id        String   @id @default(cuid())
  /// "YYYY-MM-DD"
  date      String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

/// Contact form submissions, kept separate from bookings.
model ContactMessage {
  id        String   @id @default(cuid())
  reference String   @unique
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  consentContact Boolean
  handledAt DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
